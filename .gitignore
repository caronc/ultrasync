# Python bytecode
*.py[cod]
__pycache__/

# Test, coverage and tox output
.tox/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Created during wheel builds
build/
dist/
*.egg-info/
.eggs/

# Local virtual environments
.venv/
venv/

# Panel captures from "ultrasync --debug-dump"; these can hold personal
# details, so they must never be committed by accident
*.ultrasync-dump
*.ultrasync-dump.*
